# Caddyfile — reverse proxy + automatic HTTPS (Let's Encrypt) for PINKWARD.
#
# Caddy obtains and renews a TLS cert automatically for the domain below, as
# long as it resolves to this server (A/AAAA record -> VPS IP) and ports
# 80/443 are open (ops/setup-server.sh opens them via ufw).
#
# To change the domain: edit the line below then `systemctl reload caddy`.

# www → apex redirect (needs a www A record pointing to this VPS too)
www.pinkward.lol {
    redir https://pinkward.lol{uri} permanent
}

pinkward.lol {
    encode zstd gzip
    reverse_proxy 127.0.0.1:8000

    # --- Optional extra lock: uncomment to require a password in front of the
    # whole app (on top of the app's own login). Generate the hash with:
    #     caddy hash-password --plaintext 'your-password'
    # basic_auth {
    #     scout <bcrypt-hash-here>
    # }
}
