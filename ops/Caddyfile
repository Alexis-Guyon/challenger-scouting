# Caddyfile — reverse proxy + automatic HTTPS (Let's Encrypt) for the
# Challenger Scouting app on an OVH VPS.
#
# Caddy obtains and renews a TLS cert automatically for the hostname below,
# as long as it resolves to this server and ports 80/443 are open.
#
# The OVH-provided hostname already points to the VPS, so it works out of the
# box. If you later add your own domain, just change the line below and reload:
#   systemctl reload caddy
#
# Ports 80 + 443 must be open (ops/setup-server.sh opens them via ufw).

vps-bae259d0.vps.ovh.net {
    encode zstd gzip
    reverse_proxy 127.0.0.1:8000

    # --- Optional extra lock: uncomment to require a password in front of the
    # whole app (on top of the app's own login). Generate the hash with:
    #     caddy hash-password --plaintext 'your-password'
    # basic_auth {
    #     scout <bcrypt-hash-here>
    # }
}
